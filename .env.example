# 免费图库
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 火山方舟：ARK_API_KEY 共用；Seedream 4.0 按公开价保守估为 ¥0.25/张
ARK_API_KEY=
SEEDREAM_MODEL_ID=doubao-seedream-4-0-250828
SEEDREAM_ESTIMATED_CNY_PER_IMAGE=0.25
# SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Seedance 视频：模型与单镜估价全部填写后才启用
SEEDANCE_MODEL_ID=
SEEDANCE_ESTIMATED_CNY_PER_CLIP=
# SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# MiniMax 海螺：全部填写后才启用
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL_ID=speech-2.8-turbo
VIDEO_FACTORY_MAX_CLOUD_VOICE_PREVIEWS_PER_HOUR=12
# MINIMAX_TTS_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_VIDEO_MODEL_ID=
MINIMAX_ESTIMATED_CNY_PER_CLIP=
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Wan / 阿里云 Model Studio：全部填写后才启用
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
WAN_MODEL_ID=
WAN_ESTIMATED_CNY_PER_CLIP=
# WAN_BASE_URL=

# 抖音官方热点：仅在应用获批 hotsearch scope 后启用
DOUYIN_HOTSEARCH_ENABLED=0
DOUYIN_CLIENT_TOKEN=

# 本地热点服务（运行 make setup-local-trends 后无需修改）
VIDEO_FACTORY_TRENDRADAR_URL=http://127.0.0.1:8080
VIDEO_FACTORY_NEWSNOW_URL=http://127.0.0.1:4444
VIDEO_FACTORY_DAILYHOT_URL=http://127.0.0.1:6688
VIDEO_FACTORY_RSSHUB_URL=http://127.0.0.1:1200

# Codex 语义层：broker 运行在宿主机 vf-codex 用户（apps/codex-broker），容器经 Unix socket 调用。
# 未运行 broker 时，选题总编与视觉导演自动退化为规则/模板行为，不伪造模型结果。
# VIDEO_FACTORY_CODEX_SOCKET_PATH=/run/video-factory-codex/worker.sock
# 智谱普通 BigModel API 视觉审片使用独立 broker；API key 只进入 broker 专用 0600 环境文件，不进入本文件或应用容器。
# 本地开发默认读取 .local/secrets/zai-bigmodel.env；生产读取 /etc/video-factory/zai-codex-broker.env。
# VIDEO_FACTORY_ZAI_CODEX_SOCKET_PATH=/run/video-factory-zai-codex/worker.sock

# Web 登录（生产环境必须配置；密码只保存 scrypt 哈希）
# 生成哈希：printf '%s' '你的密码' | npm run --silent auth:hash
VIDEO_FACTORY_AUTH_USERNAME=
VIDEO_FACTORY_AUTH_PASSWORD_HASH=
VIDEO_FACTORY_AUTH_SESSION_SECRET=
# VIDEO_FACTORY_AUTH_SESSION_TTL_SECONDS=43200

# Web 与持久化工作区
# 单条制作的服务端硬预算；前端填写更高数值也会被拒绝。
VIDEO_FACTORY_MAX_RUN_COST_CNY=20
# STUDIO_HOST=127.0.0.1
# STUDIO_PORT=4317
# VIDEO_FACTORY_WORKSPACE=/absolute/path/to/workspace/factory

# 可选：覆盖自动发现的本地运行时。RUNTIME 变量填写目录；
# VIDEO_FACTORY_PYTHON 单独填写 Python 可执行文件。
# VIDEO_FACTORY_PYTHON_RUNTIME=/absolute/path/to/.local/python
# VIDEO_FACTORY_PYTHON=/absolute/path/to/.local/python/.venv/bin/python
