{
  "name": "@video-factory/production-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./character-script": {
      "types": "./dist/character-script.d.ts",
      "import": "./dist/character-script.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    },
    "./model-connection": {
      "types": "./dist/model-connection.d.ts",
      "import": "./dist/model-connection.js"
    },
    "./audio-review": {
      "types": "./dist/audio-review.d.ts",
      "import": "./dist/audio-review.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./narration-text": {
      "types": "./dist/narration-text.d.ts",
      "import": "./dist/narration-text.js"
    },
    "./visual-evidence-boundary": {
      "types": "./dist/visual-evidence-boundary.d.ts",
      "import": "./dist/visual-evidence-boundary.js"
    }
  },
  "bin": {
    "video-factory-production": "./dist/cli.js"
  },
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.14",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@video-factory/template-core": "0.1.0",
    "@video-factory/workflow-core": "0.1.0",
    "proper-lockfile": "^4.1.2"
  }
}
