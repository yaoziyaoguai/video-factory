{
  "name": "video-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "auth:hash": "tsx scripts/hash-password.ts",
    "build": "npm run studio:build",
    "studio:build": "npm run build --workspace @video-factory/studio",
    "studio:dev": "npm run dev --workspace @video-factory/studio",
    "studio:start": "npm run start --workspace @video-factory/studio",
    "studio:test": "npm test --workspace @video-factory/studio",
    "typecheck": "npm run typecheck --workspace @video-factory/studio",
    "test": "npm run typecheck && npm run studio:test && npm run build",
    "contracts:generate": "node contracts/agent/v1/verify.mjs --generate",
    "contracts:check": "node contracts/agent/v1/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "15.0.4"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.2"
    },
    "undici@^7.0.0": "7.30.1"
  }
}
