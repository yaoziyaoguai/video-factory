[Unit]
Description=VideoFactory DeepSeek broker (Unix socket only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vf-deepseek-codex
Group=vf-bridge
UMask=0007
Environment=HOME=/home/vf-deepseek-codex
Environment=PATH=/opt/video-factory/codex-broker/bin:/usr/local/bin:/usr/bin:/bin
# 文件保存 DEEPSEEK_API_KEY 及可选模型 ID，部署时必须安装为 root:root 0600；值不得写入 unit 或命令行。
EnvironmentFile=/etc/video-factory/deepseek-codex-broker.env
ExecStartPre=/usr/bin/bash -c 'test "$(/usr/bin/stat -c %%U:%%G /etc/video-factory/deepseek-codex-broker.env)" = root:root'
ExecStartPre=/usr/bin/bash -c 'test "$(/usr/bin/stat -c %%a /etc/video-factory/deepseek-codex-broker.env)" = 600'
Environment=VIDEO_FACTORY_CODEX_PROFILE=deepseek
Environment=VIDEO_FACTORY_CODEX_EFFORT=xhigh
Environment=VIDEO_FACTORY_CODEX_SOCKET_PATH=/run/video-factory-deepseek-codex/worker.sock
Environment=VIDEO_FACTORY_CODEX_WORKSPACE_ROOT=/var/lib/video-factory-deepseek-codex/workspace
Environment=VIDEO_FACTORY_CODEX_TIMEOUT_MS=1200000
# 维护门禁：与 app/部署共用短锁和持久登记，排空期间只接续已登记链路。
Environment=VIDEO_FACTORY_MAINTENANCE_DIR=/opt/video-factory/codex-broker/deployment/maintenance
ExecStart=/opt/video-factory/codex-broker/bin/node /opt/video-factory/codex-broker/current/dist/main.js
RuntimeDirectory=video-factory-deepseek-codex
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
Restart=on-failure
RestartSec=3
# 排空先于停止；若退出异常，保留关闭门禁等待核查，不由 systemd 强杀。
TimeoutStopSec=infinity
SendSIGKILL=no

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/video-factory-deepseek-codex /run/video-factory-deepseek-codex /opt/video-factory/codex-broker/deployment/maintenance

[Install]
WantedBy=multi-user.target
