[Unit]
Description=VideoFactory ZAI visual-review broker (Unix socket only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vf-zai-codex
Group=vf-bridge
UMask=0007
Environment=HOME=/home/vf-zai-codex
Environment=PATH=/opt/video-factory/codex-broker/bin:/usr/local/bin:/usr/bin:/bin
# 文件只包含 ZAI_API_KEY，部署时必须安装为 root:root 0600；值不得写入 unit 或命令行。
EnvironmentFile=/etc/video-factory/zai-codex-broker.env
ExecStartPre=/usr/bin/bash -c 'test "$(/usr/bin/stat -c %%U:%%G /etc/video-factory/zai-codex-broker.env)" = root:root'
ExecStartPre=/usr/bin/bash -c 'test "$(/usr/bin/stat -c %%a /etc/video-factory/zai-codex-broker.env)" = 600'
Environment=VIDEO_FACTORY_CODEX_PROFILE=zai
Environment=VIDEO_FACTORY_CODEX_EFFORT=max
Environment=VIDEO_FACTORY_CODEX_SOCKET_PATH=/run/video-factory-zai-codex/worker.sock
Environment=VIDEO_FACTORY_CODEX_TIMEOUT_MS=285000
ExecStart=/opt/video-factory/codex-broker/bin/node /opt/video-factory/codex-broker/current/dist/main.js
RuntimeDirectory=video-factory-zai-codex
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/video-factory-zai-codex

[Install]
WantedBy=multi-user.target
