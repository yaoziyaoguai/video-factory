# 复制为 .env.docker.prod，仅保留在服务器，禁止提交真实值。
VIDEO_FACTORY_AUTH_USERNAME=owner
VIDEO_FACTORY_AUTH_PASSWORD_HASH=
VIDEO_FACTORY_AUTH_SESSION_SECRET=
VIDEO_FACTORY_AUTH_SESSION_TTL_SECONDS=43200

# 可选免费素材 API
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 可选付费视频模型；整组填写后才启用。
ARK_API_KEY=
SEEDANCE_MODEL_ID=
SEEDANCE_ESTIMATED_CNY_PER_CLIP=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
WAN_MODEL_ID=
WAN_ESTIMATED_CNY_PER_CLIP=

# Codex bridge（宿主机 systemd 服务，运行于 vf-codex 用户）；容器只通过 Unix socket 访问，
# 不挂载 ~/.codex，也不接收任何模型 API key。媒体生成 API 仍按需配置。
# VIDEO_FACTORY_CODEX_RUNTIME_DIR=/run/video-factory-codex
# VIDEO_FACTORY_CODEX_SOCKET_PATH=/run/video-factory-codex/worker.sock
# 宿主机 socket 组（vf-bridge）的数字 gid，须与 broker socket 的属组一致。
VIDEO_FACTORY_CODEX_SOCKET_GID=1001

# 可选热点服务。容器内不能使用宿主机的 127.0.0.1；
# 若服务运行在宿主机，可使用 http://host.docker.internal:<port>。
VIDEO_FACTORY_TRENDRADAR_URL=
VIDEO_FACTORY_NEWSNOW_URL=
VIDEO_FACTORY_DAILYHOT_URL=
VIDEO_FACTORY_RSSHUB_URL=
