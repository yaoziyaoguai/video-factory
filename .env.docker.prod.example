# 复制成服务器私有的 .env.docker.prod (0600)。切勿提交真实值。
VIDEO_FACTORY_AUTH_USERNAME=creator
VIDEO_FACTORY_AUTH_PASSWORD_HASH=
VIDEO_FACTORY_AUTH_SESSION_SECRET=
VIDEO_FACTORY_AUTH_SESSION_TTL_SECONDS=43200
# 发布时从 PUBLIC_HEALTH_URL 推导；手工启动需显式提供。
# AGENT_UI_ORIGIN=https://video.example.com
# FRAME_EDGE_TTS_PYTHON=/opt/frame-tts/bin/python3
# RELEASE_SHA=<完整 Git 提交>
# 可选：服务器自己的出站代理。模型与免费服务连接在登录后的网页中配置。
# FRAME_HTTPS_PROXY=
# FRAME_HTTP_PROXY=
# FRAME_NO_PROXY=localhost,127.0.0.1,vf-newsnow
# 可选：同网 NewsNow 私网 origin 的显式授权（逗号分隔，条目为纯 http(s) origin）。
# NEWSNOW_ALLOWED_ORIGINS=http://vf-newsnow:4444

# 用 openssl rand -base64 32 生成。须与数据库一同妥善保管，滚动发布沿用同一把密钥。
FRAME_CREDENTIAL_SECRET=
# FRAME_BILLING_STATEMENT_SOURCE=/data/factory/agent/billing-statements.ndjson
# FRAME_BUDGET_TZ=Asia/Shanghai
# FRAME_ASR_LANGUAGE=zh
