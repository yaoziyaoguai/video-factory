# 复制为 .env.docker.prod，仅保留在服务器，禁止提交真实值。
VIDEO_FACTORY_AUTH_USERNAME=owner
VIDEO_FACTORY_AUTH_PASSWORD_HASH=
VIDEO_FACTORY_AUTH_SESSION_SECRET=
VIDEO_FACTORY_AUTH_SESSION_TTL_SECONDS=43200

# 可选免费素材 API
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 可选付费视频模型；整组填写后才启用。
ARK_API_KEY=
SEEDANCE_MODEL_ID=
SEEDANCE_ESTIMATED_CNY_PER_CLIP=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
WAN_MODEL_ID=
WAN_ESTIMATED_CNY_PER_CLIP=

# 可选热点与 Agent 服务。容器内不能使用宿主机的 127.0.0.1；
# 若服务运行在宿主机，可使用 http://host.docker.internal:<port>。
VIDEO_FACTORY_TRENDRADAR_URL=
VIDEO_FACTORY_NEWSNOW_URL=
VIDEO_FACTORY_DAILYHOT_URL=
VIDEO_FACTORY_RSSHUB_URL=
VIDEO_FACTORY_OLLAMA_URL=
VIDEO_FACTORY_TOPIC_MODEL=qwen3:4b
VIDEO_FACTORY_DIRECTOR_MODEL=qwen3:8b
