[Unit]
Description=Frame creative runner (private Unix socket)
Requires=docker.service
After=docker.service

[Service]
Type=simple
User=@USER@
Group=@GROUP@
SupplementaryGroups=@DOCKER_GROUP@
Environment=PATH=@DOCKER_PATH@:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/rm -f @SOCKET_DIRECTORY@/runner.sock
ExecStart=@NODE@ /opt/frame-creative/creative-runner-host.mjs --socket=@SOCKET_DIRECTORY@/runner.sock --workspace-root=@WORKSPACE_ROOT@ --docker-socket=@DOCKER_SOCKET@ --uid=1001 --gid=1001
Restart=on-failure
RestartSec=2
TimeoutStopSec=45
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@WORKSPACE_ROOT@ @SOCKET_DIRECTORY@

[Install]
WantedBy=multi-user.target
